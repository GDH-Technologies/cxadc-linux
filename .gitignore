# Editors / IDEs
.idea/
.vscode/
.directory

# Agent tooling: local Claude Code state and the git worktrees it creates.
# Untracked files here make every checkout dirty, and deploy.yml refuses to
# deploy a dirty tree -- which is what silently blocked the 1.1 rollout on wm.
/.claude/

# Userland build output
/build/
/leveladj
/levelmon

/.github/workflows/logs

# Kernel module build artifacts (built in place under src/kernel/)
*.cmd
.*.cmd
*.o
*.o.*
*.ko
*.mod
*.mod.c
*.mod.o
*.symvers
*.order
Module.symvers
modules.order
built-in.a
.tmp_versions/

# Python
__pycache__/
*.pyc
